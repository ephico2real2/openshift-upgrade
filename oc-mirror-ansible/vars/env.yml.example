# Values of one environment: a lab or a datacenter. Copy this file to vars/env-<name>.yml and
# pass it to every run with -e @vars/env-<name>.yml. It holds no secrets: the logins stay in the
# Vault files (vars/redhat-pull-secret.json, vars/credentials.yml or vars/registry-<name>.yml).
# If a run also takes a registry file with -e @, put the registry file last: the later file wins.

base_path: "/data/oc-mirror"                          # archives, cache, ImageSets, cluster resources
oc_mirror_bin: "/usr/local/bin/oc-mirror"             # where oc-mirror is installed on this host
target_registry_fqdn: "registry-lab.example.com:8443" # the registry that d2m and m2m push to
mirror_namespace: "ocp4v2"                            # the Quay organization, the same on every registry
