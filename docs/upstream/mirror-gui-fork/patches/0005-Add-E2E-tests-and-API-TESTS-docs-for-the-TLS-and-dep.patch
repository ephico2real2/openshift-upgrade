 **Response:**
@@ -533,30 +534,57 @@ curl "http://localhost:3000/api/operators/odf-operator/dependencies?catalogUrl=r
 {
   "operator": "odf-operator",
   "catalogType": "redhat-operator-index",
-  "catalogVersion": "v4.18",
+  "catalogVersion": "v4.21",
